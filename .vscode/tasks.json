{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Capture DevTools Console (Windows)",
      "type": "process",
      "command": "cmd.exe",
      "args": [
        "/c",
        "${workspaceFolder}\\.vscode\\run-capture.bat"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Capture DevTools Console (macOS/Linux)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/.vscode/capture-devtools.sh"
      ],
      "group": "build",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
